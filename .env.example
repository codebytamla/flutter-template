# Firebase Configuration
# Get these values from your Firebase project settings
# https://console.firebase.google.com/

# Firebase Project Settings (shared across platforms)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Web Platform Configuration
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_APP_ID=1:123456789:web:abcdef123456
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Android Platform Configuration
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_ANDROID_APP_ID=1:123456789:android:abcdef123456

# iOS Platform Configuration
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_IOS_APP_ID=1:123456789:ios:abcdef123456
FIREBASE_IOS_BUNDLE_ID=com.yourcompany.yourapp

# macOS Platform Configuration
FIREBASE_MACOS_API_KEY=your-macos-api-key
FIREBASE_MACOS_APP_ID=1:123456789:macos:abcdef123456
FIREBASE_MACOS_BUNDLE_ID=com.yourcompany.yourapp

# Google Sign-In Configuration
# Get these from your GoogleService-Info.plist file
GOOGLE_CLIENT_ID_IOS=123456-abcdef.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.123456-abcdef
